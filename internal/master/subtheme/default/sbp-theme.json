{
  "$schema": "https://sbpanel.dev/schema/sub-theme-v1.json",
  "api": 1,
  "id": "default",
  "name": { "en": "Default", "zh-CN": "默认" },
  "version": "1.2.0",
  "author": "sbpanel",
  "description": { "en": "Card-based, mobile-first subscription page", "zh-CN": "卡片式、移动优先的订阅页" },
  "homepage": "",
  "license": "MIT",
  "preview": "preview.jpg",
  "entry": "index.html",
  "settings": [
    { "type": "title", "label": { "en": "Appearance", "zh-CN": "外观" } },
    { "key": "palette", "type": "select", "label": { "en": "Palette", "zh-CN": "配色" }, "default": "neutral",
      "options": [ { "value": "neutral", "label": { "en": "Graphite", "zh-CN": "石墨" } }, { "value": "rosepine", "label": "Rosé Pine" }, { "value": "catppuccin", "label": "Catppuccin" }, { "value": "nord", "label": "Nord" } ] },
    { "key": "accent", "type": "color", "label": { "en": "Accent color", "zh-CN": "强调色" }, "default": "",
      "help": { "en": "Leave empty to use the palette's accent", "zh-CN": "留空则使用配色自带的强调色" } },
    { "key": "default_mode", "type": "select", "label": { "en": "Default light/dark", "zh-CN": "默认明暗" }, "default": "system",
      "options": [ { "value": "system", "label": { "en": "Follow system", "zh-CN": "跟随系统" } }, { "value": "light", "label": { "en": "Light", "zh-CN": "浅色" } }, { "value": "dark", "label": { "en": "Dark", "zh-CN": "深色" } } ] },
    { "type": "title", "label": { "en": "Content", "zh-CN": "内容" } },
    { "key": "show_node_address", "type": "switch", "label": { "en": "Show node address and port", "zh-CN": "显示节点地址与端口" }, "default": true },
    { "key": "show_node_qr", "type": "switch", "label": { "en": "QR code button on node cards", "zh-CN": "节点卡片显示二维码按钮" }, "default": true },
    { "key": "clients", "type": "multiselect", "label": { "en": "Clients to show", "zh-CN": "显示的客户端" }, "default": ["singbox", "mihomo", "shadowrocket", "hiddify", "v2rayng", "nekobox", "stash"],
      "options": "$clients" },
    { "key": "footer", "type": "text", "label": { "en": "Footer text", "zh-CN": "页脚文字" }, "default": "", "maxLength": 200 }
  ]
}
